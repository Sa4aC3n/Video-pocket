## Video Pocket — Local Properties Configuration Example
## Copy this file to 'local.properties' and fill in your values.
## IMPORTANT: Never commit 'local.properties' or your keystore file to version control.

# Path to your Android SDK installation:
sdk.dir=C:\\Users\\Administrator\\AppData\\Local\\Android\\Sdk

# Release Signing Keystore Configuration (Upload Key for Google Play):
# Default path looks for 'app/videopocket-release.jks' with keyAlias 'videopocket'
# Alternatively, configure via environment variables:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
release.keystorePath=videopocket-release.jks
release.keystorePassword=YourKeystorePasswordHere
release.keyAlias=videopocket
release.keyPassword=YourKeyPasswordHere
